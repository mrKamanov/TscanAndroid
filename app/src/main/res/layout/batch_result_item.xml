<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="start">

        <!-- ВЕРХНЯЯ ЧАСТЬ: Текстовые элементы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Левая часть: номер работы + имя файла + результат + статус -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <!-- Первая строка: номер работы + оценка -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_filename"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Работа 11"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:fontFamily="@font/krabuler"
                        android:gravity="start" />

                    <TextView
                        android:id="@+id/tv_grade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Оценка: 5"
                        android:textColor="@color/primary_blue"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:fontFamily="@font/krabuler"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <!-- Вторая строка: имя файла -->
                <TextView
                    android:id="@+id/tv_filename_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMG_20241201_143022.jpg"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/krabuler"
                    android:layout_marginBottom="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="start" />

                <!-- Третья строка: результат + процент -->
                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10/10 (100%)"
                    android:textColor="@color/success_green"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="@font/krabuler"
                    android:layout_marginBottom="6dp"
                    android:gravity="start" />

                <!-- Четвертая строка: краткий статус -->
                <TextView
                    android:id="@+id/tv_errors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Обнаружены исправления"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/krabuler"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:gravity="start" />
            </LinearLayout>

            <!-- Правая часть: кнопка Подробнее -->
        </LinearLayout>

        <!-- НИЖНЯЯ ЧАСТЬ: Превью изображения -->
        <ImageView
            android:id="@+id/iv_preview"
            android:layout_width="131dp"
            android:layout_height="126dp"
            android:adjustViewBounds="true"
            android:background="@drawable/edit_text_background"
            android:scaleType="centerCrop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:backgroundTint="#1E293B"
            android:contentDescription="Показать подробности результата"
            android:elevation="0dp"
            android:fontFamily="@font/krabuler"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            android:text="Подробнее"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:strokeColor="#475569"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
